NODE_ENV=development
PORT=5050

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/clubconnect"
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/clubconnect_test"

CLIENT_URL="http://localhost:5173"

JWT_ACCESS_SECRET="replace_with_a_secure_random_secret_at_least_32_chars"
JWT_REFRESH_SECRET="replace_with_a_different_secure_random_secret_at_least_32_chars"

ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

COOKIE_SECRET="replace_with_a_secure_cookie_secret"

UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=5242880
