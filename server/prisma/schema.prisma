generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GlobalRole {
  STUDENT
  SUPER_ADMIN
}

enum ClubRole {
  MEMBER
  PRESIDENT
  VICE_PRESIDENT
  SECRETARY
  TREASURER
  COORDINATOR
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REJECTED
  LEFT
  REMOVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  UNDER_REVIEW
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ContributionType {
  TASK
  EVENT
  PROJECT
  LEADERSHIP
  VOLUNTEERING
  OTHER
}

enum ContributionStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum EventStatus {
  DRAFT
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum RegistrationStatus {
  REGISTERED
  CANCELLED
  ATTENDED
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  ACCEPTED
  REJECTED
}

enum NotificationType {
  REGISTRATION
  APPLICATION_SUBMITTED
  APPLICATION_DECISION
  TASK_ASSIGNED
  TASK_DEADLINE
  TASK_STATUS
  CONTRIBUTION_SUBMITTED
  CONTRIBUTION_REVIEWED
  EVENT_CREATED
  EVENT_REGISTERED
  ANNOUNCEMENT
}

model User {
  id            String     @id @default(uuid())
  fullName      String
  email         String     @unique
  passwordHash  String
  profileImage  String?
  department    String?
  course        String?
  yearOfStudy   String?
  bio           String?
  skills        String[]   @default([])
  interests     String[]   @default([])
  globalRole    GlobalRole @default(STUDENT)
  isActive      Boolean    @default(true)
  emailVerified Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  createdClubs          Club[]                   @relation("ClubCreator")
  memberships           ClubMembership[]
  createdTasks          Task[]                   @relation("TaskCreator")
  assignedTasks         Task[]                   @relation("TaskAssignee")
  taskActivities        TaskActivity[]
  contributions         Contribution[]           @relation("ContributionAuthor")
  verifiedContributions Contribution[]           @relation("ContributionVerifier")
  createdEvents         Event[]                  @relation("EventCreator")
  eventRegistrations    EventRegistration[]
  applications          RecruitmentApplication[] @relation("Applicant")
  reviewedApplications  RecruitmentApplication[] @relation("ApplicationReviewer")
  createdAnnouncements  Announcement[]           @relation("AnnouncementAuthor")
  notifications         Notification[]
  refreshTokens         RefreshToken[]

  @@index([email])
  @@index([globalRole])
}

model Club {
  id                     String   @id @default(uuid())
  name                   String
  slug                   String   @unique
  description            String
  shortDescription       String
  category               String
  logo                   String?
  coverImage             String?
  accentColor            String   @default("#e6f3fe")
  mission                String?
  meetingSchedule        String?
  expectedTimeCommitment String?
  requirements           String[] @default([])
  skills                 String[] @default([])
  interests              String[] @default([])
  location               String?
  isRecruiting           Boolean  @default(true)
  isActive               Boolean  @default(true)
  requireVerification    Boolean  @default(true)
  contributionPointsConfig Json?
  createdById            String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  createdBy     User                     @relation("ClubCreator", fields: [createdById], references: [id], onDelete: Restrict)
  memberships   ClubMembership[]
  tasks         Task[]
  contributions Contribution[]
  events        Event[]
  applications  RecruitmentApplication[]
  announcements Announcement[]

  @@index([slug])
  @@index([category])
  @@index([isRecruiting, isActive])
}

model ClubMembership {
  id        String           @id @default(uuid())
  userId    String
  clubId    String
  role      ClubRole         @default(MEMBER)
  status    MembershipStatus @default(PENDING)
  joinedAt  DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([userId, clubId])
  @@index([clubId, status])
  @@index([userId, status])
}

model Task {
  id           String       @id @default(uuid())
  title        String
  description  String
  clubId       String
  createdById  String
  assignedToId String?
  priority     TaskPriority @default(MEDIUM)
  status       TaskStatus   @default(TODO)
  dueDate      DateTime?
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  club          Club           @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdBy     User           @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo    User?          @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  activities    TaskActivity[]
  contributions Contribution[]

  @@index([clubId, status])
  @@index([assignedToId, status])
  @@index([dueDate])
}

model TaskActivity {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  action    String
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
}

model Contribution {
  id               String             @id @default(uuid())
  userId           String
  clubId           String
  taskId           String?
  title            String
  description      String
  contributionType ContributionType   @default(TASK)
  hoursSpent       Float              @default(0)
  points           Int                @default(0)
  status           ContributionStatus @default(PENDING)
  verifiedById     String?
  reviewNote       String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user       User  @relation("ContributionAuthor", fields: [userId], references: [id], onDelete: Restrict)
  club       Club  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  task       Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  verifiedBy User? @relation("ContributionVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([clubId, status])
  @@index([userId, status])
}

model Event {
  id          String      @id @default(uuid())
  clubId      String
  title       String
  description String
  location    String
  category    String      @default("Workshop")
  startDate   DateTime
  endDate     DateTime?
  coverImage  String?
  capacity    Int
  createdById String
  status      EventStatus @default(UPCOMING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  club          Club                @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdBy     User                @relation("EventCreator", fields: [createdById], references: [id], onDelete: Restrict)
  registrations EventRegistration[]

  @@index([clubId, startDate])
  @@index([status])
}

model EventRegistration {
  id           String             @id @default(uuid())
  eventId      String
  userId       String
  status       RegistrationStatus @default(REGISTERED)
  registeredAt DateTime           @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId, status])
}

model RecruitmentApplication {
  id             String            @id @default(uuid())
  userId         String
  clubId         String
  motivation     String
  skills         String[]          @default([])
  experience     String?
  preferredRole  String
  status         ApplicationStatus @default(SUBMITTED)
  reviewedById   String?
  reviewNotes    String?
  onboardingStep Int               @default(1)
  appliedAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user       User  @relation("Applicant", fields: [userId], references: [id], onDelete: Cascade)
  club       Club  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([clubId, status])
  @@index([userId, clubId])
}

model Notification {
  id                String           @id @default(uuid())
  userId            String
  title             String
  message           String
  type              NotificationType
  relatedEntityId   String?
  relatedEntityType String?
  isRead            Boolean          @default(false)
  createdAt         DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model Announcement {
  id          String   @id @default(uuid())
  clubId      String
  title       String
  content     String
  createdById String
  isPinned    Boolean  @default(false)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  club      Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdBy User @relation("AnnouncementAuthor", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([clubId, isPinned, publishedAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
